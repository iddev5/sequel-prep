generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Problem {
  id Int @id @default(autoincrement())
  title String
  description String @db.Text
  difficulty Int

  topics String[]
  companies String[]

  schemaData String @db.Text
  correctQuery String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
